#include <winver.h>

#define IDI_APP       1
#define IDI_TRAY_REC  2
#define IDI_TRAY_BUSY 3
#define IDI_TRAY_WARN 4

IDI_APP       ICON "icons/app.ico"
IDI_TRAY_REC  ICON "icons/tray-rec.ico"
IDI_TRAY_BUSY ICON "icons/tray-busy.ico"
IDI_TRAY_WARN ICON "icons/tray-warn.ico"

1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    WT_VERSION_COMMAS
 PRODUCTVERSION WT_VERSION_COMMAS
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "WhistleType contributors"
            VALUE "FileDescription",  "WhistleType - local push-to-talk dictation"
            VALUE "FileVersion",      WT_VERSION_STR
            VALUE "InternalName",     "WhistleType"
            VALUE "OriginalFilename", "WhistleType.exe"
            VALUE "ProductName",      "WhistleType"
            VALUE "ProductVersion",   WT_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
